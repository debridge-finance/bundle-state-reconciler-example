{
    "/v1/gasless/bundles": {
        "get": {
            "description": "Retrieve bundles with flexible filtering (intentOwner, intentAuthority, userId, referralCode, date ranges), sorting (by createdAt or updatedAt), and pagination. Includes execution trades (subtrades) for each bundle trade.",
            "operationId": "BundlesController_getBundles",
            "parameters": [
                {
                    "name": "intentOwner",
                    "required": false,
                    "in": "query",
                    "description": "Ethereum address of the intent owner",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "intentAuthority",
                    "required": false,
                    "in": "query",
                    "description": "Ethereum address of the intent authority",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "userId",
                    "required": false,
                    "in": "query",
                    "description": "User identifier",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "referralCode",
                    "required": false,
                    "in": "query",
                    "description": "Referral code",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "orderIds",
                    "required": false,
                    "in": "query",
                    "description": "Comma-separated list of order IDs to filter bundles. Returns bundles containing trades with matching order IDs. Example format: 0x1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "createdFrom",
                    "required": false,
                    "in": "query",
                    "description": "Filter by creation date from (ISO 8601 format: YYYY-MM-DDTHH:mm:ssZ)",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "createdTo",
                    "required": false,
                    "in": "query",
                    "description": "Filter by creation date to (ISO 8601 format: YYYY-MM-DDTHH:mm:ssZ)",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "updatedFrom",
                    "required": false,
                    "in": "query",
                    "description": "Filter by update date from (ISO 8601 format: YYYY-MM-DDTHH:mm:ssZ)",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "updatedTo",
                    "required": false,
                    "in": "query",
                    "description": "Filter by update date to (ISO 8601 format: YYYY-MM-DDTHH:mm:ssZ)",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "sort",
                    "required": false,
                    "in": "query",
                    "description": "Sort field and direction. Prefix with - for descending order. When sorting by updatedAt, bundles without updatedAt will be sorted by createdAt instead.",
                    "schema": {
                        "default": "-createdAt",
                        "example": "-createdAt",
                        "type": "string",
                        "enum": [
                            "createdAt",
                            "-createdAt",
                            "updatedAt",
                            "-updatedAt"
                        ]
                    }
                },
                {
                    "name": "page",
                    "required": false,
                    "in": "query",
                    "description": "Page number (1-based)",
                    "schema": {
                        "minimum": 1,
                        "default": 1,
                        "example": 1,
                        "type": "number"
                    }
                },
                {
                    "name": "pageSize",
                    "required": false,
                    "in": "query",
                    "description": "Number of items per page",
                    "schema": {
                        "minimum": 1,
                        "maximum": 100,
                        "default": 25,
                        "example": 25,
                        "type": "number"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Bundles found and returned successfully",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/gasless-api_PaginatedBundlesResponseDto"
                            }
                        }
                    }
                },
                "500": {
                    "description": "Internal server error"
                }
            },
            "security": [
                {
                    "X-Partner": []
                },
                {
                    "X-User": []
                }
            ],
            "summary": "Get bundles with filters, sorting, and pagination",
            "tags": [
                "Gasless API"
            ],
            "x-source-service": "Gasless API",
            "x-source-path": "/bundles",
            "x-source-key": "gasless-api"
        }
    },
    "gasless-api_PaginatedBundlesResponseDto": {
        "type": "object",
        "properties": {
            "bundles": {
                "description": "Array of bundles",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_BundleResponseDto"
                }
            },
            "total": {
                "type": "number",
                "description": "Total number of bundles matching the filters",
                "example": 100
            },
            "page": {
                "type": "number",
                "description": "Current page number",
                "example": 1
            },
            "pageSize": {
                "type": "number",
                "description": "Number of items per page",
                "example": 25
            },
            "totalPages": {
                "type": "number",
                "description": "Total number of pages",
                "example": 4
            }
        },
        "required": [
            "bundles",
            "total",
            "page",
            "pageSize",
            "totalPages"
        ]
    },
    "gasless-api_BundleResponseDto": {
        "type": "object",
        "properties": {
            "bundleId": {
                "type": "string",
                "description": "Unique bundle identifier",
                "example": "bundle_123abc"
            },
            "referralCode": {
                "type": "string",
                "description": "Optional referral code"
            },
            "status": {
                "type": "string",
                "description": "Current status of the bundle",
                "enum": [
                    "created",
                    "partially_fulfilled",
                    "fulfilled",
                    "expired",
                    "cancelled",
                    "failed"
                ],
                "example": "created"
            },
            "isAtomic": {
                "type": "boolean",
                "description": "Whether this bundle is atomic (all trades must succeed together)",
                "example": true
            },
            "tradingAlgorithm": {
                "type": "string",
                "description": "Trading algorithm to use",
                "enum": [
                    "MARKET"
                ]
            },
            "trades": {
                "description": "Array of trades generated from the intents",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_BundleTradeResponseDto"
                }
            },
            "intents": {
                "description": "Array of intents included in this bundle",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_IntentWithActionsDto"
                }
            },
            "preHooks": {
                "description": "Pre execution hooks",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_HookDto"
                }
            },
            "postHooks": {
                "description": "Post execution hooks",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_HookDto"
                }
            },
            "partnerCancelAuthority": {
                "description": "Partner cancel authorities",
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "cancel": {
                "description": "Bundle cancellation details",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/gasless-api_BundleCancelDto"
                    }
                ]
            },
            "userId": {
                "type": "string",
                "description": "User identifier"
            },
            "executedSrc": {
                "type": "boolean",
                "description": "Whether the bundle has been executed on source chain",
                "example": false
            },
            "executedDst": {
                "type": "boolean",
                "description": "Whether the bundle has been executed on destination chain",
                "example": false
            },
            "finalizedSrc": {
                "type": "boolean",
                "description": "Whether the bundle has been finalized on source chain",
                "example": false
            },
            "finalizedDst": {
                "type": "boolean",
                "description": "Whether the bundle has been finalized on destination chain",
                "example": false
            },
            "lockSrcTokenBalanceUpdate": {
                "type": "boolean",
                "description": "Whether the source token balance update is locked"
            },
            "createdAt": {
                "type": "string",
                "description": "Bundle creation timestamp (ISO 8601 format: YYYY-MM-DDTHH:mm:ss.sssZ)",
                "format": "date-time"
            },
            "updatedAt": {
                "type": "string",
                "description": "Bundle last update timestamp (ISO 8601 format: YYYY-MM-DDTHH:mm:ss.sssZ)",
                "format": "date-time"
            }
        },
        "required": [
            "bundleId",
            "status",
            "isAtomic",
            "trades",
            "intents",
            "executedSrc",
            "executedDst",
            "finalizedSrc",
            "finalizedDst",
            "createdAt"
        ]
    },
    "gasless-api_BundleTradeResponseDto": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "description": "Bundle trade database identifier",
                "example": "507f1f77bcf86cd799439011"
            },
            "tradeId": {
                "type": "string",
                "description": "Unique trade identifier (first subtrade ID, for backward compatibility)",
                "example": "trade_123"
            },
            "intentId": {
                "type": "string",
                "description": "Associated intent identifier",
                "example": "intent_456"
            },
            "tokenIn": {
                "description": "Input token details",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/gasless-api_TradeTokenInDto"
                    }
                ]
            },
            "tokenOut": {
                "description": "Output token details",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/gasless-api_TradeTokenOutDto"
                    }
                ]
            },
            "receiverAddress": {
                "type": "string",
                "description": "Receiver address",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "srcAuthorityAddress": {
                "type": "string",
                "description": "Source authority address"
            },
            "dstAuthorityAddress": {
                "type": "string",
                "description": "Destination authority address"
            },
            "externalCall": {
                "description": "External call details",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/gasless-api_ExternalCallDto"
                    }
                ]
            },
            "status": {
                "type": "string",
                "description": "Current trade status",
                "enum": [
                    "created",
                    "partially_fulfilled",
                    "fulfilled",
                    "cancelled",
                    "failed",
                    "expired"
                ],
                "example": "created"
            },
            "executedSrc": {
                "type": "boolean",
                "description": "Whether the trade has been executed on source chain",
                "example": false
            },
            "executedDst": {
                "type": "boolean",
                "description": "Whether the trade has been executed on destination chain",
                "example": false
            },
            "finalizedSrc": {
                "type": "boolean",
                "description": "Whether the trade has been finalized on source chain",
                "example": false
            },
            "finalizedDst": {
                "type": "boolean",
                "description": "Whether the trade has been finalized on destination chain",
                "example": false
            },
            "finalizedBlockSrc": {
                "type": "object",
                "description": "Block number where source chain finalized",
                "example": "12345678"
            },
            "finalizedBlockDst": {
                "type": "object",
                "description": "Block number where destination chain finalized",
                "example": "87654321"
            },
            "subtrades": {
                "description": "Execution trades (subtrades) for this bundle trade",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_SubtradeResponseDto"
                }
            }
        },
        "required": [
            "id",
            "intentId",
            "tokenIn",
            "tokenOut",
            "receiverAddress",
            "status",
            "executedSrc",
            "executedDst",
            "finalizedSrc",
            "finalizedDst",
            "subtrades"
        ]
    },
    "gasless-api_SubtradeResponseDto": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "description": "Execution trade identifier",
                "example": "0xabc123..."
            },
            "status": {
                "type": "string",
                "description": "Trade batch status",
                "enum": [
                    "created",
                    "partially_fulfilled",
                    "fulfilled",
                    "cancelled",
                    "failed",
                    "expired"
                ]
            },
            "tokenInAmount": {
                "type": "string",
                "description": "Actual executed input amount (may be partial)",
                "example": "500000000000000000"
            },
            "tokenOutAmount": {
                "type": "string",
                "description": "Actual executed output amount (may be partial)",
                "example": "450000000000000000"
            },
            "tokenOutMinAmount": {
                "type": "string",
                "description": "Minimum output amount for this execution",
                "example": "440000000000000000"
            },
            "orderId": {
                "type": "string",
                "description": "Order ID from execution",
                "example": "0x456"
            },
            "transactionHash": {
                "type": "string",
                "description": "Transaction hash from blockchain execution (same-chain intents only)",
                "example": "0x789abc..."
            },
            "createdAt": {
                "format": "date-time",
                "type": "string",
                "description": "Creation timestamp",
                "example": "2024-01-01T00:00:00.000Z"
            }
        },
        "required": [
            "id",
            "status",
            "tokenInAmount",
            "tokenOutAmount",
            "tokenOutMinAmount",
            "createdAt"
        ]
    },
    "gasless-api_IntentWithActionsDto": {
        "type": "object",
        "properties": {
            "intentId": {
                "type": "string",
                "description": "Intent identifier",
                "example": "intent_789"
            },
            "requiredActions": {
                "description": "Required actions for this intent",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_ActionDto"
                }
            },
            "intent": {
                "type": "object",
                "description": "Intent constraints",
                "additionalProperties": true
            }
        },
        "required": [
            "intentId",
            "requiredActions",
            "intent"
        ]
    },
    "gasless-api_HookDto": {
        "type": "object",
        "properties": {
            "isAtomic": {
                "type": "boolean",
                "description": "Whether the hook is atomic",
                "example": true
            },
            "data": {
                "type": "string",
                "description": "Hook data as hex string",
                "example": "0x..."
            },
            "to": {
                "type": "string",
                "description": "Target address for the hook",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "value": {
                "type": "string",
                "description": "Value to send with the hook",
                "example": "0"
            },
            "chainId": {
                "type": "number",
                "description": "Chain ID for the hook",
                "example": 1
            },
            "requiredActions": {
                "description": "Required actions for the hook",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_ActionDto"
                }
            },
            "tokenAddress": {
                "type": "string",
                "description": "Token address for the hook",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "from": {
                "type": "string",
                "description": "From address for the hook",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "executedSrc": {
                "type": "boolean",
                "description": "Whether the hook has been executed on source chain",
                "example": false
            },
            "executedDst": {
                "type": "boolean",
                "description": "Whether the hook has been executed on destination chain",
                "example": false
            },
            "finalizedSrc": {
                "type": "boolean",
                "description": "Whether the hook has been finalized on source chain",
                "example": false
            },
            "finalizedDst": {
                "type": "boolean",
                "description": "Whether the hook has been finalized on destination chain",
                "example": false
            },
            "finalizedBlockSrc": {
                "type": "object",
                "description": "Block number where source chain finalized",
                "example": "12345678"
            },
            "finalizedBlockDst": {
                "type": "object",
                "description": "Block number where destination chain finalized",
                "example": "87654321"
            }
        },
        "required": [
            "isAtomic",
            "data",
            "to",
            "value",
            "chainId",
            "requiredActions",
            "tokenAddress",
            "from",
            "executedSrc",
            "executedDst",
            "finalizedSrc",
            "finalizedDst"
        ]
    },
    "gasless-api_BundleCancelDto": {
        "type": "object",
        "properties": {
            "preImage": {
                "type": "string",
                "description": "Pre-image for cancellation",
                "example": "0x..."
            },
            "signature": {
                "type": "string",
                "description": "Cancellation signature",
                "example": "0x..."
            },
            "authority": {
                "type": "string",
                "description": "Authority who cancelled",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "createdAt": {
                "type": "string",
                "description": "When the cancellation was created",
                "format": "date-time"
            },
            "reason": {
                "type": "string",
                "description": "Cancellation reason"
            }
        },
        "required": [
            "preImage",
            "signature",
            "authority",
            "createdAt"
        ]
    },
    "gasless-api_TradeTokenInDto": {
        "type": "object",
        "properties": {
            "chainId": {
                "type": "number",
                "description": "Chain ID where the token exists",
                "example": 1
            },
            "address": {
                "type": "string",
                "description": "Token contract address",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "amount": {
                "type": "string",
                "description": "Token amount",
                "example": "1000000000000000000"
            },
            "isWrapped": {
                "type": "boolean",
                "description": "Whether the token is wrapped",
                "example": false
            }
        },
        "required": [
            "chainId",
            "address",
            "amount"
        ]
    },
    "gasless-api_TradeTokenOutDto": {
        "type": "object",
        "properties": {
            "chainId": {
                "type": "number",
                "description": "Chain ID where the token exists",
                "example": 1
            },
            "address": {
                "type": "string",
                "description": "Token contract address",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "amount": {
                "type": "string",
                "description": "Token amount",
                "example": "1000000000000000000"
            },
            "minAmount": {
                "type": "string",
                "description": "Minimum acceptable amount",
                "example": "950000000000000000"
            }
        },
        "required": [
            "chainId",
            "address",
            "amount",
            "minAmount"
        ]
    },
    "gasless-api_ExternalCallDto": {
        "type": "object",
        "properties": {
            "executionFee": {
                "type": "string",
                "description": "Execution fee",
                "example": "100000000000000"
            },
            "fallbackAddressDst": {
                "type": "string",
                "description": "Fallback address on destination",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "data": {
                "type": "string",
                "description": "Call data",
                "example": "0x..."
            }
        },
        "required": [
            "executionFee",
            "fallbackAddressDst",
            "data"
        ]
    },
    "gasless-api_ActionDto": {
        "type": "object",
        "properties": {
            "type": {
                "type": "number",
                "description": "Signature type",
                "enum": [
                    0,
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "example": 2
            },
            "actions": {
                "type": "array",
                "description": "Signature actions",
                "example": [
                    3
                ],
                "items": {
                    "type": "number",
                    "enum": [
                        0,
                        1,
                        2,
                        3,
                        4,
                        5,
                        6
                    ]
                }
            },
            "data": {
                "description": "Action data",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/gasless-api_ActionDataDto"
                    }
                ]
            },
            "signedData": {
                "type": "string",
                "description": "Signed data as hex string",
                "example": "0x..."
            },
            "gasPayment": {
                "description": "Gas payment information for this action",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/gasless-api_GasPaymentDto"
                    }
                ]
            },
            "actionId": {
                "type": "string",
                "description": "Unique identifier for this action",
                "example": "action_123"
            }
        },
        "required": [
            "type",
            "actions",
            "signedData"
        ]
    },
    "gasless-api_GasPaymentDto": {
        "type": "object",
        "properties": {
            "type": {
                "type": "string",
                "description": "Gas payment type",
                "enum": [
                    "sponsor",
                    "user_token",
                    "spread"
                ],
                "example": "spread"
            },
            "basicDetails": {
                "description": "Basic payment details",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/gasless-api_GasPaymentBasicDetailsDto"
                    }
                ]
            },
            "takenUserTokens": {
                "description": "Tokens taken from user",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/gasless-api_TakenUserTokensDto"
                }
            }
        }
    },
    "gasless-api_TakenUserTokensDto": {
        "type": "object",
        "properties": {
            "tokenAddress": {
                "type": "string",
                "description": "Token contract address",
                "example": "0x742d35Cc6634C0532925a3b844Bc9e7595f0bEBc"
            },
            "tokenAmount": {
                "type": "string",
                "description": "Token amount taken",
                "example": "1000000000000000000"
            }
        },
        "required": [
            "tokenAddress",
            "tokenAmount"
        ]
    },
    "gasless-api_GasPaymentBasicDetailsDto": {
        "type": "object",
        "properties": {
            "nativeTokenAmount": {
                "type": "string",
                "description": "Native token amount",
                "example": "100000000000000000"
            },
            "approximateUsdEquivalent": {
                "type": "string",
                "description": "Approximate USD equivalent",
                "example": "250.50"
            }
        },
        "required": [
            "nativeTokenAmount",
            "approximateUsdEquivalent"
        ]
    }
}