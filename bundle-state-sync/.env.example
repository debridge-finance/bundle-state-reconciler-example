POSTGRES_USER=bundlesync
POSTGRES_PASSWORD=bundlesync
POSTGRES_DB=bundlesync
DATABASE_URL=postgresql://bundlesync:bundlesync@postgres:5432/bundlesync

DEBRIDGE_API_URL=https://api-gaslessb2b.debridge.finance
DEBRIDGE_WS_URL=wss://api-gaslessb2b.debridge.finance/ws
# Local development (mock API):
# DEBRIDGE_API_URL=http://localhost:3000
# DEBRIDGE_WS_URL=ws://localhost:3001
DEBRIDGE_API_KEY=your-api-key-here
REFERRAL_CODE=your-referral-code-here

WORKER2_POLL_INTERVAL_MS=15000
WORKER3_POLL_INTERVAL_MS=60000
WORKER2_OVERLAP_BUFFER_SECONDS=10
WORKER3_MAX_CHECK_COUNT=15
# Minimum bundle age before Worker 3 will poll it (avoids re-checking bundles WS is already tracking)
WORKER3_MIN_BUNDLE_AGE_MINUTES=5

# Rate limiting (requests per minute)
# RATE_LIMIT_TOTAL_RPM=300
# RATE_LIMIT_WORKER2_RPM=200
# RATE_LIMIT_WORKER3_RPM=100

# WebSocket configuration
# WS_MAX_SUBS_PER_CONNECTION=100
# WS_RECONNECT_BASE_MS=500
# WS_RECONNECT_MAX_MS=30000

LOG_LEVEL=INFO

# ── Producer (test data seeder) ──────────────────────────────────────────────
# PRODUCER_DATABASE_URL=postgresql://bundlesync:bundlesync@localhost:5432/bundlesync
# MOCK_API_URL=http://localhost:3000
# PRODUCER_TOTAL_BUNDLES=100
# PRODUCER_RPS=10
# PRODUCER_DISTRIBUTION=fulfilled:50,partially_fulfilled:15,partially_fulfilled_expired:5,cancelled:10,expired:10,failed:10

# ── Checker (verification) ───────────────────────────────────────────────────
# MOCK_API_DATABASE_URL=postgresql://mockapi:mockapi@localhost:5433/mockapi
